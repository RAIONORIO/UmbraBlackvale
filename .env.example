# Docker images
POSTGRES_IMAGE=postgres:17.10-alpine
REDIS_IMAGE=redis:8.6.4-alpine

# PostgreSQL
POSTGRES_CONTAINER_NAME=umbra-blackvale-postgres
POSTGRES_DATABASE=umbra_blackvale
POSTGRES_USERNAME=umbra_blackvale
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# Redis
REDIS_CONTAINER_NAME=umbra-blackvale-redis
REDIS_PASSWORD=change_this_local_password
REDIS_PORT=6379